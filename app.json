{
  "expo": {
    "name": "Arena Play",
    "slug": "arena-play",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "arenaplay",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EAF4F0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arenaplay.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0FB89B"
      },
      "package": "com.arenaplay.app",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "INTERNET",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#EAF4F0",
          "resizeMode": "contain"
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "27.1.12297006"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0FB89B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Arena Play needs your photos so you can attach payment and match result screenshots."
        }
      ],
      "./plugins/withSlimAbi"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
